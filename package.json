{
  "name": "bhinsearch",
  "version": "1.0.2",
  "private": true,
  "homepage": "https://jewook-an.github.io/BHinSearch",
  "dependencies": {
    "@capacitor/android": "^8.1.0",
    "@capacitor/app": "^8.0.1",
    "@capacitor/browser": "^8.0.1",
    "@capacitor/cli": "^8.1.0",
    "@capacitor/core": "^8.1.0",
    "@capacitor/device": "^8.0.1",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/ios": "^8.1.0",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/local-notifications": "^8.0.1",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.1",
    "@codetrix-studio/capacitor-google-auth": "^3.3.6",
    "@react-oauth/google": "^0.13.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^13.5.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.0",
    "react-scripts": "5.0.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "postinstall": "patch-package",
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "build:mobile": "cross-env PUBLIC_URL=. react-scripts build",
    "//": "'predeploy' : 'npm run build'",
    "predeploy": "npm run build && cd admin && npm run build",
    "deploy": "gh-pages -d build",
    "cap:init": "npx cap init BHinSearch com.bhinsearch.app --web-dir=build",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:sync": "npm run build && npx cap sync",
    "cap:copy": "npm run build && npx cap copy",
    "cap:update": "npx cap update",
    "android": "npm run build:mobile && npx cap sync android && npx cap open android",
    "android:build": "npm run build:mobile && npx cap sync android",
    "android:run": "npx cap run android",
    "ios": "npm run build && npx cap sync ios && npx cap open ios",
    "ios:build": "npm run build && npx cap sync ios",
    "ios:run": "npx cap run ios",
    "mobile:build": "npm run build:mobile && npx cap sync"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "cross-env": "^10.1.0",
    "gh-pages": "^6.3.0",
    "patch-package": "^8.0.1",
    "typescript": "^5.9.3"
  }
}