# 환경 변수 설정 예시
# 프로덕션에서는 반드시 .env 파일 생성하여 설정하세요

# MongoDB (로컬 또는 Atlas)
MONGODB_URL=mongodb://localhost:27017
# 또는 MongoDB Atlas:
# MONGODB_URL=mongodb+srv://username:password@cluster.mongodb.net/?appName=appname
DATABASE_NAME=bhinsearch_db

# JWT 설정 (⚠️ 프로덕션에서는 강력한 랜덤 값으로 변경 필수!)
SECRET_KEY=your-secret-key-here-change-in-production-use-secrets.token_hex(32)
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# CORS (JSON 배열 형식으로 작성)
ALLOWED_ORIGINS=["http://localhost:3000","https://jewook-an.github.io"]

# 파일 업로드
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# 서버 설정
API_V1_PREFIX=/api/v1
PROJECT_NAME=보험업계 ATS API
